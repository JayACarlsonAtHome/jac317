description "TreeSync engine side: settings, options, paths, disks (no GUI)\n";

uses
	Core,
	Core/SSH,
	plugin/sqlite3;

file
	TreeSyncCore.h,
	Contracts.h,
	Contracts.cpp,
	Options.cpp,
	FsPath.cpp,
	Disks.cpp,
	Root.cpp,
	Progress.cpp,
	Toolchain.cpp,
	Bench.cpp,
	AiExport.cpp,
	Engine.h,
	Runner.h,
	Db.cpp,
	Scan.cpp,
	Plan.cpp,
	Copy.cpp,
	CopyReport.cpp,
	LocalFs.cpp,
	SftpFs.cpp,
	Ids.cpp,
	Sync.cpp,
	Stream.cpp,
	Check.cpp;

options
	"-Wformat=2 -Werror=format -DTS_FORMAT_CHECKED=1";
